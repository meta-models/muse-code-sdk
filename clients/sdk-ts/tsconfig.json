{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "stripInternal": true
  },
  "include": ["src/**/*.ts", "qa/**/*.ts", "test/**/*.ts", "test/**/*.d.ts"],
  // #32029 B-1: disclosed staging, the TypeScript analogue of the Rust tests'
  // cfg(any()) gate. This test reads config.developerPrompt, which the
  // generated MSP types (schema/msp/msp.d.ts) do not carry at this head; the L3
  // switch PR adds the protocol member, regenerates the declarations and removes
  // this exclusion.
  "exclude": ["test/developer-prompt-real-binary.test.ts"]
}
